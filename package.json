{
  "name": "pccd",
  "type": "module",
  "description": "Paremiologia catalana comparada digital",
  "repository": "https://github.com/Softcatala/pccd.git",
  "homepage": "https://pccd.dites.cat",
  "bugs": "https://github.com/Softcatala/pccd/issues",
  "author": "Pere Orga Esteve <pere@orga.cat>",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "analysis": "concurrently -g --timings 'npm:analysis:*'",
    "analysis:phpstan": "./composer.phar run phpstan",
    "analysis:psalm": "./composer.phar run psalm",
    "build:assets": "node scripts/build-assets.js",
    "check": "./composer.phar run php-l && concurrently -g --timings npm:lint npm:analysis npm:test:node npm:test:phpunit",
    "clean": "find tmp -mindepth 1 ! -path 'tmp/.keep' -delete",
    "convert:db": "node scripts/install/convert-database.js",
    "decompress:images": "scripts/install/decompress-images.sh",
    "export:code": "npm run clean && scripts/export-code.sh",
    "export:commonvoice": "scripts/common-voice-export/export.sh",
    "export:db": "scripts/export-db.sh",
    "export:reports": "docker compose exec -T web php scripts/report-generation/export_db_for_reports.php",
    "fix": "concurrently -g --timings 'npm:fix:*'",
    "fix:composer": "./composer.phar run composer-normalize",
    "fix:css": "stylelint --fix strict src/css/",
    "fix:dockerfmt": "dockerfmt --write .docker/*Dockerfile",
    "fix:eslint": "eslint --fix  '*.js' 'scripts/**' 'src/**' 'tests/**'",
    "fix:markdown": "markdownlint-cli2 --fix",
    "fix:php-cs-fixer": "./composer.phar run php-cs-fixer",
    "fix:phpcbf": "./composer.phar run phpcbf",
    "fix:prettier": "prettier --write .",
    "fix:shfmt": "shfmt --apply-ignore -l -w .",
    "fix:yaml": "ryl --fix --strict .",
    "generate:reports": "npm run export:reports && concurrently -g --timings 'npm:generate:reports:*'",
    "generate:reports:fonts_urls": "node scripts/report-generation/report-fonts-urls.js",
    "generate:reports:image_formats": "node scripts/validate/validate-image-formats.js",
    "generate:reports:imatges_duplicades": "node scripts/report-generation/report-duplicate-images.js",
    "generate:reports:imatges_links": "node scripts/report-generation/report-imatges-links.js",
    "generate:reports:imatges_no_existents": "node scripts/report-generation/report-imatges-no-existents.js",
    "generate:reports:imatges_no_referenciades": "node scripts/report-generation/report-imatges-no-referenciades.js",
    "generate:reports:imatges_urls": "node scripts/report-generation/report-imatges-urls.js",
    "generate:reports:intl_modismes_molt_diferents": "node scripts/report-generation/report-intl-modismes-molt-diferents.js",
    "generate:reports:intl_modismes_repetits": "node scripts/report-generation/report-intl-modismes-repetits.js",
    "generate:reports:intl_modismes_sospitosos": "node scripts/report-generation/report-intl-modismes-sospitosos.js",
    "generate:reports:intl_paremiotipus_repetits": "node scripts/report-generation/report-intl-paremiotipus-repetits.js",
    "generate:reports:intl_paremiotipus_sospitosos": "node scripts/report-generation/report-intl-paremiotipus-sospitosos.js",
    "generate:reports:languagetool": "scripts/report-generation/languagetool-checker/generate-lt-report.sh",
    "generate:reports:llibres_urls": "node scripts/report-generation/report-llibres-urls.js",
    "generate:reports:paremiotipus_accents": "node scripts/report-generation/report-paremiotipus-accents.js",
    "generate:reports:paremiotipus_repetits": "node scripts/report-generation/report-paremiotipus-repetits.js",
    "generate:reports:small_images": "node scripts/report-generation/report-small-images.js",
    "generate:reports:unsupported_image_extensions": "node scripts/report-generation/report-unsupported-image-extensions.js",
    "import:commonvoice": "scripts/common-voice-import/import.sh",
    "postinstall": "./composer.phar install --no-interaction && npx playwright install --with-deps chromium",
    "install:db": "scripts/install.sh",
    "lint": "concurrently -g --timings 'npm:lint:*'",
    "lint:case-sensitive-filenames": "node scripts/lint/check-case-sensitive-filenames.js",
    "lint:composer": "./composer.phar validate --strict",
    "lint:composer-normalize": "./composer.phar run composer-normalize-lint",
    "lint:css": "stylelint src/css/",
    "lint:docker": "if command -v hadolint >/dev/null 2>&1; then hadolint .docker/*Dockerfile; else echo 'hadolint not found, skipping docker linting' >&2; exit 0; fi",
    "lint:dockerfmt": "dockerfmt --check .docker/*Dockerfile",
    "lint:eslint": "eslint '*.js' 'scripts/**' 'src/**' 'tests/**'",
    "lint:eslint-redundancy": "node scripts/lint/eslint-check-rule-redundancy.js",
    "lint:gitlab-ci": "node scripts/lint/check-gitlab-ci-npm-linters.js",
    "lint:htmlhint-completeness": "node scripts/lint/htmlhint-check-rule-completeness.js",
    "lint:htmlvalidate-redundancy": "node scripts/lint/htmlvalidate-check-rule-redundancy.js",
    "lint:ls": "ls-lint",
    "lint:markdown": "markdownlint-cli2",
    "lint:package-json": "node scripts/lint/check-package-dependency-versions.js",
    "lint:php-cs-fixer": "./composer.phar run php-cs-fixer-lint",
    "lint:phpcs": "./composer.phar run phpcs",
    "lint:prettier": "prettier --log-level log --check .",
    "lint:shellcheck": "find scripts tests -type f -name '*.sh' ! -name '*.generated.sh' -exec shellcheck {} +",
    "lint:shfmt": "shfmt --apply-ignore -l -d .",
    "lint:stylelint-redundancy": "node scripts/lint/stylelint-check-rule-redundancy.js",
    "lint:xml": "node scripts/lint/xmllint.js",
    "lint:yaml": "ryl --strict .",
    "optimize:images": "node scripts/install/optimize-images.js && npm run optimize:svg",
    "optimize:svg": "svgo --eol lf --multipass -r --folder docroot/img",
    "outdated": "concurrently -g --timings 'npm:outdated:*'",
    "outdated:composer": "./composer.phar outdated --direct",
    "outdated:npm": "npm outdated",
    "refresh:test-data": "node tests/playwright/refresh-test-data.js",
    "release": "scripts/release.sh",
    "test": "npm run test:node && npm run test:phpunit && npm run test:e2e && npm run validate:pages && npm run validate:lighthouse && npm run validate:ssl-expiration",
    "test:e2e": "playwright test",
    "test:node": "node --test tests/node/*.test.js",
    "test:phpunit": "./composer.phar run phpunit",
    "update": "([ -d node_modules ] || npm install --no-audit --ignore-scripts) && concurrently -g --timings 'npm:update:*'",
    "update:composer": "./composer.phar self-update && pkgs=$(./composer.phar show --direct --name-only) && [ -z \"$pkgs\" ] || ./composer.phar require --dev --update-with-all-dependencies $pkgs",
    "update:docker": "dcu -u",
    "update:npm": "ncu -u --install never && npm install --ignore-scripts && npm update --ignore-scripts && npx playwright install",
    "validate:lighthouse": "node scripts/validate/lighthouse-audit.js",
    "validate:pages": "node scripts/validate/validate-pages.js",
    "validate:sitemap-urls": "node scripts/validate/validate-sitemap-urls.js",
    "validate:ssl-expiration": "node scripts/validate/validate-ssl-expiration.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ls-lint/ls-lint": "2.3.1",
    "@moderation-api/unicode-spoofing": "0.4.0",
    "@owenlamont/ryl": "0.22.0",
    "@pccd/lt-filter": "7.8.0",
    "@playwright/test": "1.63.0",
    "@reteps/dockerfmt": "0.5.4",
    "chart.js": "4.5.1",
    "concurrently": "10.0.5",
    "docker-check-updates": "0.2.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "fastest-levenshtein": "1.0.16",
    "globals": "17.13.0",
    "html-validate": "11.16.1",
    "htmlhint": "1.9.2",
    "lighthouse": "13.5.0",
    "lightningcss": "1.33.0",
    "markdownlint-cli2": "0.23.3",
    "npm-check-updates": "23.1.0",
    "prettier": "3.9.9",
    "prettier-plugin-pkg": "0.22.1",
    "sharp": "0.35.5",
    "simple-datatables": "10.3.0",
    "stylelint": "17.16.0",
    "stylelint-config-recess-order": "7.8.0",
    "stylelint-config-standard": "40.0.0",
    "svgo": "4.1.0",
    "xmllint-wasm": "5.3.0"
  }
}
